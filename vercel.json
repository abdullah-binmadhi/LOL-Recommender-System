{
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/rust-preview",
      "destination": "/rust-preview/index.html"
    },
    {
      "source": "/rust-preview/",
      "destination": "/rust-preview/index.html"
    },
    {
      "source": "/LOL-Recommender-System/(.*)",
      "destination": "/$1"
    },
    {
      "source": "/LOL-Recommender-System",
      "destination": "/rust-preview/index.html"
    },
    {
      "source": "/distribution",
      "destination": "/rust-preview/index.html"
    },
    {
      "source": "/analytics",
      "destination": "/rust-preview/index.html"
    },
    {
      "source": "/",
      "destination": "/rust-preview/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/rust-preview/(.*)\\.wasm",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/wasm"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/public/wasm/(.*)\\.wasm",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/wasm"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/src/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, immutable"
        },
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ]
}
